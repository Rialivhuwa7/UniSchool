{
  "name": "@unischool/api",
  "version": "0.1.0",
  "private": true,
  "description": "Typed UniSchool API client, data types and shared business rules for the web and mobile apps",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "fetch": "node scripts/fetch-spec.mjs",
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts --properties-required-by-default",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
